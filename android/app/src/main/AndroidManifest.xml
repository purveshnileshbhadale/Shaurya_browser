<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Browsing needs the network; nothing else here is optional. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Background playback. Without a foreground service the system silences
        a WebView within seconds of the app leaving the foreground, so this is
        not an optimisation — it is the whole feature.

        POST_NOTIFICATIONS is runtime-requested on Android 13+ and only when
        playback actually starts: asking at launch, before there is anything
        to notify about, is how apps get denied permanently.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ShauryaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shaurya"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Shaurya">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Offer Shaurya as a browser for http(s) links. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>

            <!-- And as a target for shared text and links. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            Keeps audio and video playing when Shaurya is backgrounded or the
            screen is off, and puts real transport controls on the lock screen.
            Started only while something is playing and stopped the moment it
            is not: a browser holding a foreground service the whole time it
            is open would be killed for it on Android 12+, and rightly.
        -->
        <service
            android:name=".media.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
            Routes hardware media keys and Bluetooth headset buttons into the
            MediaSession. Without it the notification's own buttons work but
            the ones on a user's headphones do not.
        -->
        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Required on Android 11+ to detect other browsers for "open with". -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
