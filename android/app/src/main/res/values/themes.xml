<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Compose paints everything, so the platform theme exists only to get
        out of the way: transparent system bars for edge-to-edge, and no
        action bar or window background to flash before the first frame.

        Deliberately *not* setting windowLightStatusBar here. It was hardcoded
        true, which put dark status-bar icons on the dark theme's toolbar,
        where they are invisible. The activity sets it at runtime from the
        resolved theme instead, which is the only place that knows whether
        "system" currently means dark.
    -->
    <style name="Theme.Aether" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:navigationBarDividerColor">@android:color/transparent</item>
    </style>
</resources>
