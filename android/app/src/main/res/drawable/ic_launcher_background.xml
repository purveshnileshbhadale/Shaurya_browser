<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher background: the same violet-to-magenta the start page is
    built on, so the icon and the first screen belong to each other.

    Drawn as a vector rather than a PNG per density: an adaptive icon is
    108dp and gets masked, scaled and parallaxed by the launcher, and a
    bitmap has to be shipped at five densities to survive that.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#FF8B5CF6" />
                <item android:offset="0.55" android:color="#FFA855F7" />
                <item android:offset="1" android:color="#FFEC4899" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- A highlight off the top-left, so the icon has a light source rather
         than reading as a flat diagonal ramp. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="24" android:centerY="15"
                android:gradientRadius="97">
                <item android:offset="0" android:color="#BFC084FC" />
                <item android:offset="1" android:color="#00C084FC" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
